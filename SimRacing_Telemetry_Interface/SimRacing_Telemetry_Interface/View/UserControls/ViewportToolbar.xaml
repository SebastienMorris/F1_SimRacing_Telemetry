<UserControl x:Class="SimRacing_Telemetry_Interface.View.UserControls.ViewportToolbar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:SimRacing_Telemetry_Interface.View.UserControls"
             xmlns:viewmodel="clr-namespace:SimRacing_Telemetry_Interface.ViewModel"
             mc:Ignorable="d"
             x:Name="Root"
             Height="30" d:DesignWidth="800" d:DataContext="{d:DesignInstance Type=viewmodel:RaceDataManager}" >
    <Grid>
        <Menu Background="White">
            <MenuItem Header="Data Filters" FontSize="16" ItemsSource="{ Binding  RaceData.Keys }">
                <MenuItem.ItemTemplate>
                    <DataTemplate>
                        <MenuItem  Header="{Binding .}" Command="{Binding  UpdateDataFilterCommand, ElementName=Root}" CommandParameter="{Binding .}" />
                    </DataTemplate>
                </MenuItem.ItemTemplate>
            </MenuItem> 
        </Menu>
    </Grid>
</UserControl>
