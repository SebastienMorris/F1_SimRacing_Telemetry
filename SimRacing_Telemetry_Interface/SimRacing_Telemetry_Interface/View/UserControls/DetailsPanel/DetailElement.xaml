<UserControl x:Class="SimRacing_Telemetry_Interface.View.UserControls.DetailsPanel.DetailElement"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:SimRacing_Telemetry_Interface.View.UserControls.DetailsPanel"
             mc:Ignorable="d"
             d:DesignHeight="20" d:DesignWidth="200" d:DataContext="{d:DesignInstance Type=local:DetailElement}">
    
    <StackPanel Orientation="Horizontal" >
        <TextBlock Text="{Binding Title }" FontSize="14" FontWeight="Bold" VerticalAlignment="Center" />
        <TextBlock Text="{Binding Value }" FontSize="14" Margin="20, 0, 0, 0" VerticalAlignment="Center"  />
    </StackPanel>
</UserControl>
