             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:SimRacing_Telemetry_Interface.View.UserControls"
             mc:Ignorable="d"
             Height="30" d:DesignWidth="800">
    <Grid>
        <Menu>
            <MenuItem Header="Connection" FontSize="14">
                <MenuItem Header="Show Server Details" FontSize="12"/>
